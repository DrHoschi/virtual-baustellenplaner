{
  "schema": "baustellenplaner.paramPack.v1",
  "id": "rollerbahn_v1",
  "label": "Rollenbahn (ParamPack v1)",
  "defaults": {
    "length": 5.5,
    "width": 1.2,
    "height": 0.55,
    "rollerCount": 5,
    "rollerPitch": 0.5
  },
  "ui": {
    "groups": [
      {
        "id": "geom",
        "label": "Geometrie",
        "fields": [
          {
            "id": "length",
            "label": "Länge (m)",
            "type": "number",
            "min": 1,
            "max": 20,
            "step": 0.01
          },
          {
            "id": "width",
            "label": "Breite (m)",
            "type": "number",
            "min": 0.6,
            "max": 4,
            "step": 0.01
          },
          {
            "id": "height",
            "label": "Höhe UK Rollenbahn (m)",
            "type": "number",
            "min": 0.2,
            "max": 2,
            "step": 0.01
          }
        ]
      },
      {
        "id": "rollers",
        "label": "Rollen",
        "fields": [
          {
            "id": "rollerCount",
            "label": "Rollenanzahl",
            "type": "number",
            "min": 1,
            "max": 50,
            "step": 1
          },
          {
            "id": "rollerPitch",
            "label": "Rollenteilung (m)",
            "type": "number",
            "min": 0.1,
            "max": 2,
            "step": 0.01
          }
        ]
      }
    ]
  },
  "apply": {
    "root": {
      "scale": {
        "xExpr": "params.length / 5.50",
        "yExpr": "1",
        "zExpr": "params.width / 1.20"
      }
    },
    "nodes": []
  },
  "bom": {
    "items": [
      {
        "id": "STEEL_KG",
        "label": "Stahl (Schätzung)",
        "unit": "kg",
        "qtyExpr": "params.length * params.width * 180",
        "unitCost": 2.2
      },
      {
        "id": "ROLLERS_PC",
        "label": "Rollen",
        "unit": "pc",
        "qtyExpr": "params.rollerCount",
        "unitCost": 85
      },
      {
        "id": "PAINT_M2",
        "label": "Lackfläche (Schätzung)",
        "unit": "m2",
        "qtyExpr": "(params.length * params.width) * 2 + (params.length * 0.25) * 2 + (params.width * 0.25) * 2",
        "unitCost": 6.0
      },
      {
        "id": "LABOR_H",
        "label": "Montage (Schätzung)",
        "unit": "h",
        "qtyExpr": "3 + params.length * 0.4",
        "unitCost": 55
      }
    ]
  }
}